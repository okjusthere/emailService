NODE_ENV=development
APP_ROLE=web
PORT=3000
BASE_URL=http://localhost:3000
DEFAULT_TIMEZONE=America/New_York
LOG_LEVEL=info
COMMIT_SHA=local

POSTGRES_PORT=5434
DATABASE_URL=postgresql://homix:homix@localhost:5434/homix_marketing?schema=public
DIRECT_DATABASE_URL=postgresql://homix:homix@localhost:5434/homix_marketing?schema=public

AUTH_MODE=local
LOCAL_ADMIN_EMAIL=admin@homixny.com
BOOTSTRAP_ADMIN_EMAILS=admin@homixny.com
AUTO_PROVISION_USERS=false
ALLOWED_EMAIL_DOMAINS=homixny.com
DEV_BYPASS_AUTH=false
SESSION_SECRET=REQUIRED_LOCAL_RANDOM_VALUE

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_PREVIOUS_SECRET=
RESEND_WEBHOOK_PREVIOUS_SECRET_EXPIRES_AT=
UNSUBSCRIBE_SIGNING_SECRET=REQUIRED_32_PLUS_CHARACTER_RANDOM_VALUE
UNSUBSCRIBE_PREVIOUS_SIGNING_SECRET=
UNSUBSCRIBE_PREVIOUS_SIGNING_SECRET_EXPIRES_AT=
EMAIL_PROVIDER=resend
EMAIL_DELIVERY_MODE=disabled
EMAIL_TEST_ALLOWLIST=admin@homixny.com

STORAGE_PROVIDER=local
LOCAL_ASSET_DIR=./data/assets
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=marketing-assets
AZURE_PRIVATE_CONTAINER=private-exports
PUBLIC_ASSET_BASE_URL=http://localhost:3000/public/assets

COMPANY_NAME=Homix Realty
COMPANY_POSTAL_ADDRESS=REQUIRED_BEFORE_LIVE_SEND
COMPANY_WEBSITE=https://homixny.com

APPLICATIONINSIGHTS_CONNECTION_STRING=
WORKER_POLL_INTERVAL_MS=2000
JOB_LOCK_SECONDS=120
WEBHOOK_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# OneKey data is served by the approved BBO listing-data service. `fake` is
# deterministic for local/E2E verification; `disabled` makes every control safe.
ONEKEY_PROVIDER=disabled
BBO_LISTING_API_BASE_URL=http://localhost:3001/api/v1
BBO_MARKETING_API_KEY=
# Exact comma-separated origins only; production does not allow HTTP or wildcard hosts.
ONEKEY_MEDIA_ALLOWED_ORIGINS=
MLS_GRID_BASE_URL=https://api.mlsgrid.com/v2
MLS_GRID_ACCESS_TOKEN=
MLS_GRID_ORIGINATING_SYSTEM_NAME=onekey2
ONEKEY_SYNC_ENABLED=false
ONEKEY_SYNC_PAGE_SIZE=100
ONEKEY_SYNC_STATUSES=Active,Coming Soon,Pending
ONEKEY_MEDIA_LIMIT=25

AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_REQUEST_TIMEOUT_MS=30000
AI_RATE_LIMIT_PER_HOUR=30
